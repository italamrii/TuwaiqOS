# Packages for TuwaiqOS Product D0 (Ubuntu 24.04)
# One package per line. Comments allowed.
# D0 targets a bootable QEMU/desktop foundation image. Full OEM firmware
# packs are optional (see HARDWARE note below) to keep the first image build
# reproducible on constrained networks.

# Kernel (virtual guest profile — swap to linux-image-generic for bare metal)
linux-image-virtual

# HARDWARE (optional for bare-metal D0 images; omit for QEMU foundation):
# linux-image-generic
# linux-firmware
# intel-microcode
# amd64-microcode

# Display manager + Plasma (X11 D0 path; Wayland remains installed for later)
sddm
sddm-theme-breeze
plasma-desktop
plasma-workspace
plasma-workspace-wayland
plasma-wayland-protocols
kwin-x11
kwin-wayland
systemsettings
plasma-nm
plasma-pa
dolphin
konsole
kate
breeze
breeze-icon-theme
fonts-noto
fonts-noto-core
fonts-noto-ui-core
fonts-noto-color-emoji

# X11 runtime required for QEMU D0 graphical acceptance
xserver-xorg
xserver-xorg-core
xserver-xorg-video-vesa
xserver-xorg-video-fbdev
xinit
x11-xserver-utils

# Base desktop utilities
network-manager
pipewire
wireplumber
mesa-vulkan-drivers
xdg-desktop-portal-kde
dbus-x11
sudo
locales
locales-all

# Arabic + English locale support
language-pack-en
language-pack-ar
language-pack-kde-en
language-pack-kde-ar

initramfs-tools

# D1 additions (identity/connectivity)
ufw
curl
iputils-ping
dnsutils

# Tuwaiq AI userspace service (agent API; no Ollama/weights in ISO)
python3
python3-minimal
