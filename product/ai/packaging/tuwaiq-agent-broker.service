[Unit]
Description=Tuwaiq AI Agent Broker (system tool authority)
Documentation=file:///usr/share/tuwaiqos/AI-PRODUCT.md
# Non-boot-critical: must not delay Plasma / display-manager.
After=local-fs.target
Before=tuwaiq-ai.service

[Service]
Type=simple
ExecStart=/usr/libexec/tuwaiq/tuwaiq-agent-broker --unix-socket /run/tuwaiq/ai-broker.sock
RuntimeDirectory=tuwaiq
RuntimeDirectoryMode=0755
# Shared with tuwaiq-ai.service. Without Preserve, stopping AI deletes
# /run/tuwaiq and unlinks the still-running broker socket.
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=2s
StartLimitIntervalSec=60
StartLimitBurst=5
TimeoutStartSec=15
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/tuwaiq
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=256M
TasksMax=64
Nice=5

[Install]
WantedBy=multi-user.target
